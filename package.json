{
  "name": "your-bank",
  "version": "1.0.0",
  "private": true,
  "description": "your-bank",
  "author": "Pavel",
  "keywords": [
    "gatsby"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "predevelop": "npm run lint:fix",
    "develop": "gatsby develop",
    "prestart": "npm run lint:fix",
    "start": "gatsby develop",
    "build": "gatsby build",
    "build:gh-pages": "gatsby build --prefix-paths",
    "serve": "gatsby serve",
    "serve:gh-pages": "gatsby serve --prefix-paths",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "gatsby": "^5.14.6",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.106.1",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
